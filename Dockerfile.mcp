FROM golang:1.25.1-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=0.1.0
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-X main.version=${VERSION}" -o /wpssh-mcp ./cmd/wpssh-mcp

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && mkdir -p /home/wpssh/.config
COPY --from=build /wpssh-mcp /usr/local/bin/wpssh-mcp
ENV HOME=/home/wpssh
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/wpssh-mcp"]
