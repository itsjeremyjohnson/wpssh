#!/usr/bin/env python3
"""Models WP Engine's SSH gateway as issue fleet#249 observed it.

The gateway parses the SSH command once, honoring and dropping quotes and
backslashes but expanding nothing, joins the words with spaces, and runs the
result with bash -c, which parses it a second time. That reproduces the four
observations: 'a b', "a b" and a\\ b each reach wp as two words, and an
unquoted COUNT(*) fails with a bash -c syntax error.

"drop" removes the last word and "bad" replaces it with "victim", to check a
damaged argument list writes nothing.
"""
import os
import shlex
import sys

words = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
mode = sys.argv[1] if len(sys.argv) > 1 else ""
if mode == "drop":
    words = words[:-1]
elif mode == "bad":
    words = words[:-1] + ["victim"]
os.execv("/bin/bash", ["bash", "-c", " ".join(words)])
